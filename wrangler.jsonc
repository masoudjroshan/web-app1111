{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app1111",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "86a94400-aba5-4379-b0ea-e50baa74b321","database_name": "web-app1111" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "56b7cd1f1c264e538f12e5b91efeb473" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
